# ── Conexión a PostgreSQL ──────────────────────────────
# Copia este archivo como .env y llena los valores reales

DB_HOST=192.168.1.X        # IP del servidor PostgreSQL en la intranet
DB_PORT=5432
DB_NAME=colbeef            # Nombre real de la base de datos
DB_USER=colbeef_user       # Usuario con permisos de lectura
DB_PASSWORD=tu_password    # Contraseña del usuario

# ── Servidor ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
